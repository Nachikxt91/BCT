# LC Document OCR Platform — API
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
APP_PUBLIC_URL=http://localhost:3000

# Database — Neon free Postgres recommended for multi-user:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
# Local zero-setup fallback (SQLite file under data/):
# DATABASE_URL=sqlite:///C:/path/to/BCT/data/ocr_platform.db
# Leave unset to use default SQLite under ../../data/ocr_platform.db

# Auth (change JWT_SECRET in any shared/deployed environment)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Optional SMTP (Resend / Gmail app password / Mailtrap). Dev logs links if empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TradeDoc <noreply@tradedoc.local>
SMTP_USE_TLS=true

# Seed defaults (python -m app.scripts.seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ORG_NAME=TradeDoc Demo

# Optional — leave empty to use heuristic/stub offline mode
GROQ_API_KEY=
GEMINI_API_KEY=

GROQ_CLASSIFY_MODEL=llama-3.1-8b-instant
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GEMINI_VISION_MODEL=gemini-2.5-flash

OCR_CONFIDENCE_THRESHOLD=0.75
MAX_VISION_PAGES_PER_PACK=10
MAX_UPLOAD_MB=50

# Optional on-chain (empty = mock attestation)
CHAIN_RPC_URL=
ATTESTATION_CONTRACT_ADDRESS=
ATTESTER_PRIVATE_KEY=
